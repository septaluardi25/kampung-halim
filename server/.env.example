# Konfigurasi Server
PORT=5000
NODE_ENV=development

# Konfigurasi Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=warga_halim

# Keamanan & Autentikasi
# Gunakan string acak minimal 32 karakter untuk produksi
JWT_SECRET=ganti_dengan_secret_panjang_minimal_32_karakter

# Frontend Origin (CORS)
CLIENT_URL=http://localhost:5173

# Vercel Blob (Upload Foto Karyawan - diisi saat fitur upload/deploy)
BLOB_READ_WRITE_TOKEN=

# Kredensial Awal Admin (Seed Admin Script - npm run seed:admin)
ADMIN_EMAIL=admin@wargahalim.id
ADMIN_PASSWORD=
